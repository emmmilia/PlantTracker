<Window x:Class="PlantTracker.Wpf.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="{StaticResource PixelFont}"
        FontSize="16"
        Background="#F5F5F0"
        Title="Delete"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" Text="delete forever?" Margin="0,0,0,20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Yes" Click="YesButton_Click" IsDefault="True"
                    Background="#E53935" Foreground="White" BorderThickness="0"
                    Padding="16,4" Margin="0,0,10,0"/>
            <Button Content="No" IsCancel="True"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Padding="16,4"/>
        </StackPanel>
    </StackPanel>
</Window>