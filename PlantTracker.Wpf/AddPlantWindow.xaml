<Window x:Class="PlantTracker.Wpf.AddPlantWindow"
        FontFamily="{StaticResource PixelFont}"
        FontSize="16"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlantTracker.Wpf"
        mc:Ignorable="d"
        Loaded="AddPlantWindow_Loaded"
        Title="AddPlantWindow"
        Height="450"
        Width="800">
    <Window.Resources>

        <!-- 1. El botón con la flechita (tiene que ir primero) -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd" Background="White" BorderBrush="#B8D8BE"
                    BorderThickness="2" CornerRadius="4">
                <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0 Z" Fill="#8FBF98"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#E8F5E9"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5 Z"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4CAF50"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 2. El ComboBox en sí -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#2E4A32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleTemplate}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center" Margin="10,0,30,0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#B8D8BE" BorderThickness="2"
                                        CornerRadius="4" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth,
                                                   RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. Cada opción de la lista -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="10,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F5E9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B8D8BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 4. Los TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#2E4A32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="White" BorderBrush="#B8D8BE"
                                BorderThickness="2" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F5E9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4CAF50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10">
            <Label Content="Plant's name:" Target="{Binding ElementName=PlantNameTextBox}" />
            <TextBox x:Name="PlantNameTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <Label Content="Plant's species:" Target="{Binding ElementName=SelectedSpeciesComboBox}" />
            <ComboBox x:Name="SelectedSpeciesComboBox"
                      ItemsSource="{Binding AvailableSpecies}"
                      SelectedItem="{Binding SelectedSpecies}"
                      DisplayMemberPath="Name"
                      Width="200"
                      Height="30"
                      Margin="0,5,0,5"/>
            <Label Content="Plant's location:" Target="{Binding ElementName=LocationTextBox}" />
            <TextBox x:Name="LocationTextBox"
                     Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <Label Content="Custom watering days:" Target="{Binding ElementName=CustomWateringFrequencyTextBox}" />
            <TextBox x:Name="CustomWateringFrequencyTextBox"
                     Text="{Binding CustomWateringFrequencyDaysInput, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <Label Content="Notes:" Target="{Binding ElementName=NotesTextBox}" />
            <TextBox x:Name="NotesTextBox"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <Button x:Name="AddPlantButton"
                    Content="Save Plant"
                    Click="SaveButton_Click"
                    Background="#B8D8BE"
                    Foreground="White"
                    Padding="8,2"
                    BorderThickness="0"
                    Width="100"
                    Height="30"
                    Margin="0,5,0,5"/>
        </StackPanel>
    </Grid>
</Window>