<Window x:Class="PlantTracker.Wpf.AddPlantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlantTracker.Wpf"
        mc:Ignorable="d"
        Loaded="AddPlantWindow_Loaded"
        Title="AddPlantWindow"
        Height="450"
        Width="800">
    <Grid>
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10">
            <TextBox x:Name="PlantNameTextBox"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <ComboBox x:Name="SelectedSpeciesComboBox"
                      ItemsSource="{Binding AvailableSpecies}"
                      SelectedItem="{Binding SelectedSpecies}"
                      DisplayMemberPath="Name"
                      Width="200"
                      Height="30"
                      Margin="0,5,0,5"/>
            <TextBox x:Name="LocationTextBox"
                     Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <TextBox x:Name="CustomWateringFrequencyTextBox"
                     Text="{Binding CustomWateringFrequencyDaysInput, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <TextBox x:Name="NotesTextBox"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Height="30"
                     Margin="0,5,0,5"/>
            <Button x:Name="AddPlantButton"
                    Content="Save Plant"
                    Click="SaveButton_Click"
                    Width="100"
                    Height="30"
                    Margin="0,5,0,5"/>
        </StackPanel>
    </Grid>
</Window>
