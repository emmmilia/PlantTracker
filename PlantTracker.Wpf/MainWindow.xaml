<Window x:Class="PlantTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlantTracker.Wpf"
        mc:Ignorable="d"
        Loaded="MainWindow_Loaded"
        Title="MainWindow"
        Height="450"
        Width="800">
    <Grid>
        <Button Content="Add Plant" Click="AddPlantButton_Click" 
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
        <ListView ItemsSource="{Binding Plants}" Margin="10,50,10,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name"
                                    DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Species"
                                    DisplayMemberBinding="{Binding Species}"/>
                    <GridViewColumn Header="Date Added"
                                    DisplayMemberBinding="{Binding DateAdded}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
