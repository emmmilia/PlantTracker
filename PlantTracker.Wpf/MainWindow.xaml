<Window x:Class="PlantTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlantTracker.Wpf"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        mc:Ignorable="d"
        FontFamily="{StaticResource PixelFont}"
        FontSize="16"
        Background="#F5F5F0"
        Loaded="MainWindow_Loaded"
        Title="MainWindow"
        Height="550"
        Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- el color de cada botón -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <!-- capa oscura que aparece en hover -->
                            <Border x:Name="Overlay" Background="Black" Opacity="0" CornerRadius="4"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Button Content="Add Plant" Click="AddPlantButton_Click"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                Background="#96ceb4" Padding="10,5"/>

        <!-- La tarjeta con las flechitas (solo si hay plantas) -->
        <Grid Margin="10,50,10,10"
              Visibility="{Binding HasPlants, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&lt;" Click="PreviousButton_Click"
                    Background="#96ceb4" Width="40" Height="40" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border DataContext="{Binding CurrentPlant}"
                        Background="White" CornerRadius="8" Padding="20" Width="320">
                    <StackPanel>
                        <!-- espacio para la foto -->
                        <Border Height="140" Background="#E8F5E9" CornerRadius="6" Margin="0,0,0,15">
                            <Grid>
                                <TextBlock Text="(foto)" Foreground="#8FBF98"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border CornerRadius="6">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding PhotoPath, Converter={StaticResource PathToImage}}"
                                                    Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding Name}" FontSize="26" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Species.Name}" Foreground="Gray"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding PlantStatus, StringFormat='Status: {0}'}"/>
                        <TextBlock Text="{Binding LastWatered, StringFormat='Last watered: {0:dd/MM/yy}'}"/>
                        <TextBlock Text="{Binding DataContext.NextWateringText,
                                          RelativeSource={RelativeSource AncestorType=Window},
                                          StringFormat='Next watering: {0}'}"/>
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap"
                                   Foreground="Gray" Margin="0,10,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Content="Water" Click="WaterButton_Click" CommandParameter="{Binding Id}"
                                    Background="#7aa2cf" Padding="12,4" Margin="0,0,8,0"/>
                            <Button Content="Edit" Click="EditButton_Click" CommandParameter="{Binding Id}"
                                    Background="#a2798f" Padding="12,4" Margin="0,0,8,0"/>
                            <Button Content="Delete" Click="DeleteButton_Click" CommandParameter="{Binding Id}"
                                    Background="#f47a62" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding PositionText}" Foreground="Gray"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Content="&gt;" Click="NextButton_Click"
                    Background="#96ceb4" Width="40" Height="40" VerticalAlignment="Center"/>
        </Grid>

        <!-- Mensaje cuando no hay plantas -->
        <TextBlock Text="no plants yet... add one! 🌱"
                   FontSize="22" Foreground="#8FBF98"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasNoPlants, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>